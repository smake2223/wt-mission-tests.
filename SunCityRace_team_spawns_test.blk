imports{}
triggers{
  isCategory:b=yes
  is_enabled:b=yes

  init_mission{
    is_enabled:b=yes
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=yes
    }

    events{
      initMission{}
    }

    conditions{}
    actions{
      missionMarkAsRespawnPoint{
        loc_name:t="Spawn (A)"
        spawnEffect:b=no
        isAirfield:b=no
        isUnit:b=no
        isStrictSpawn:b=yes
        radius:r=-1
        useExisting:b=no
        isIndividual:b=no
        removeAreas:b=no
        canSpawnOnNeutral:b=no
        showOnMap:b=yes
        onlyOnePlayerPerSpawnPoint:b=no
        resetStrictSpawnIndex:b=no
        forceCreate:b=no
        replaceAreas:b=no
        ignoreTeamsOnReuse:b=no
        target:t="tank_respawnA_teamA"
        object_type:t="any"
        team:t="A"

        tags{
          air:b=yes
          helicopter:b=yes
          tank:b=yes
        }
      }

      missionMarkAsRespawnPoint{
        loc_name:t="Spawn (B)"
        spawnEffect:b=no
        isAirfield:b=no
        isUnit:b=no
        isStrictSpawn:b=yes
        radius:r=-1
        useExisting:b=no
        isIndividual:b=no
        removeAreas:b=no
        canSpawnOnNeutral:b=no
        showOnMap:b=yes
        onlyOnePlayerPerSpawnPoint:b=no
        resetStrictSpawnIndex:b=no
        forceCreate:b=no
        replaceAreas:b=no
        ignoreTeamsOnReuse:b=no
        target:t="tank_respawnA_teamB"
        object_type:t="any"
        team:t="B"

        tags{
          air:b=yes
          helicopter:b=yes
          tank:b=yes
        }
      }

      missionMarkAsRespawnPoint{
        loc_name:t="Spawn 2 (A)"
        spawnEffect:b=no
        isAirfield:b=no
        isUnit:b=no
        isStrictSpawn:b=yes
        radius:r=-1
        useExisting:b=no
        isIndividual:b=no
        removeAreas:b=no
        canSpawnOnNeutral:b=no
        showOnMap:b=yes
        onlyOnePlayerPerSpawnPoint:b=no
        resetStrictSpawnIndex:b=no
        forceCreate:b=no
        replaceAreas:b=no
        ignoreTeamsOnReuse:b=no
        target:t="respawn_test_teamA"
        object_type:t="any"
        team:t="A"

        tags{
          air:b=yes
          tank:b=yes
          ship:b=yes
        }
      }

      missionMarkAsRespawnPoint{
        loc_name:t="Spawn 2 (B)"
        spawnEffect:b=no
        isAirfield:b=no
        isUnit:b=no
        isStrictSpawn:b=yes
        radius:r=-1
        useExisting:b=no
        isIndividual:b=no
        removeAreas:b=no
        canSpawnOnNeutral:b=no
        showOnMap:b=yes
        onlyOnePlayerPerSpawnPoint:b=no
        resetStrictSpawnIndex:b=no
        forceCreate:b=no
        replaceAreas:b=no
        ignoreTeamsOnReuse:b=no
        target:t="respawn_test_teamB"
        object_type:t="any"
        team:t="B"

        tags{
          air:b=yes
          tank:b=yes
          ship:b=yes
        }
      }

      unitSetStealth{
        set:b=yes
        radius:r=-1
        target:t="stealth_squad"
      }

      unitSetProperties{
        object:t="immortal_squad"
        object:t="all_players_squad"
        object_marking:i=0
        object_var_name:t=""
        object_var_comp_op:t="equal"
        object_var_value:i=0
        isImmortal:b=yes
        registerCollisions:b=yes
      }

      missionHint{
        setStatus:t="show"
        time:r=-1
        hint:t="hints/ffa_race_starts_in_00"
      }

      unitPutToSleep{
        target:t="structures_20"
        target:t="structures_21"
      }

      varSetInt{
        value:i=5
        var:t="penality_timer"
      }
    }

    else_actions{}
  }

  start_mission_straight{
    is_enabled:b=yes
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=no
    }

    events{
      periodicEvent{
        time:r=0
      }
    }

    conditions{}
    actions{
      __missionSetTimeSpeed{
        speed:r=0.01
        realtimeTriggers:b=yes
      }

      beginRaceMode{
        checkAreaPrefix:t="race_wp_"
        waypointsPrefix:t="race_wp_"
        winners:i=1
        doubleWaypoints:b=yes
        waypointScale:r=1
        laps:i=1
        respawnVerticalOffset:r=0
        respawnForwardOffset:r=0
        statisticsScreenAfterFinish:b=yes
        reverse:b=no
        tankRace:b=yes
        isPathClosed:b=yes
        defaultTimeToDisableWeapon:r=10000
        racePathColor:c=255, 255, 255, 255
      }

      __triggerEnable{
        target:t="a_player_is_active_requirement"
      }

      unitSetProperties{
        object:t="all_players_squad"
        object_marking:i=0
        object_var_name:t=""
        object_var_comp_op:t="equal"
        object_var_value:i=0
        targetableByAi:b=no
        isImmortal:b=yes
        cannotShoot:b=yes
        ignoreCollisions:b=yes
        cannotMove:b=yes
      }
    }

    else_actions{}
  }

  a_player_is_active_requirement{
    is_enabled:b=no
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=no
    }

    events{
      periodicEvent{
        time:r=0.1
      }
    }

    conditions{
      unitWhenStatus{
        object_type:t="isActive"
        check_objects:t="any"
        object_marking:i=0
        target_type:t="isAlive"
        check_period:r=1
        object_var_name:t=""
        object_var_comp_op:t="equal"
        object_var_value:i=0
        object:t="players_squad"
      }
    }

    actions{
      triggerEnable{
        target:t="race_start_timer"
      }
    }

    else_actions{}
  }

  race_start_timer{
    is_enabled:b=yes
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=yes
    }

    events{
      periodicEvent{
        time:r=1
      }
    }

    conditions{
      varCompareInt{
        var_value:t="start_timer_int"
        value:i=0
        comparasion_func:t="notLess"
      }
    }

    actions{
      varAddString{
        value:t="@start_timer_int"
        digits:i=2
        var:t="start_hint_id_str"
      }

      playHint{
        hintType:t="custom"
        name:t="@start_hint_id_str"
        action:t="show"
        shouldFadeOut:b=no
        time:r=-1
        priority:i=0
        isOverFade:b=no
        target_marking:i=0
        object_var_name:t=""
        object_var_comp_op:t="equal"
        object_var_value:i=0
        shouldBlink:b=no
      }

      varModify{
        operator:t="subAB"
        value:r=1
        var:t="start_timer_int"
      }

      varSetString{
        value:t="hints/ffa_race_starts_in_"
        var:t="start_hint_id_str"
      }
    }

    else_actions{
      __missionSetTimeSpeed{
        speed:r=1.15
        realtimeTriggers:b=yes
      }

      unitSetProperties{
        object:t="all_players_squad"
        object_marking:i=0
        object_var_name:t=""
        object_var_comp_op:t="equal"
        object_var_value:i=0
        targetableByAi:b=no
        isImmortal:b=yes
        cannotShoot:b=no
        ignoreCollisions:b=yes
        cannotMove:b=no
      }

      wait{
        time:r=3
      }

      playHint{
        hintType:t="custom"
        name:t=""
        action:t="hideCur"
        shouldFadeOut:b=no
        time:r=-1
        priority:i=0
        isOverFade:b=no
        target_marking:i=0
        object_var_name:t=""
        object_var_comp_op:t="equal"
        object_var_value:i=0
        shouldBlink:b=no
      }

      triggerDisable{
        target:t="race_start_timer"
      }

      triggerEnable{
        target:t="StartFire"
      }
    }
  }

  race_shooting_enabled{
    is_enabled:b=no
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
