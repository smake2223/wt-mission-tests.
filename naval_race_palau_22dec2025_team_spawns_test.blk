imports{}
triggers{
  isCategory:b=yes
  is_enabled:b=yes

  init_Mission{
    is_enabled:b=yes
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=no
    }

    events{
      initMission{}
    }

    conditions{}
    actions{
      missionMarkAsRespawnPoint{
        loc_name:t="Coastal Spawn (A)"
        spawnEffect:b=no
        isStrictSpawn:b=yes
        resetStrictSpawnIndex:b=no
        isAirfield:b=no
        isUnit:b=no
        forceCreate:b=no
        useExisting:b=no
        ignoreTeamsOnReuse:b=no
        isIndividual:b=no
        onlyOnePlayerPerSpawnPoint:b=yes
        removeAreas:b=no
        replaceAreas:b=no
        canSpawnOnNeutral:b=no
        showOnMap:b=yes
        radius:r=-1
        target:t="Race_Spawn_teamA"
        team:t="A"

        tags{
          ship:b=yes
          boat:b=yes
          type_frigate:b=no
          type_destroyer:b=no
          type_light_cruiser:b=no
          type_heavy_cruiser:b=no
          type_battlecruiser:b=no
          type_battleship:b=no
          type_submarine:b=no
        }
      }

      missionMarkAsRespawnPoint{
        loc_name:t="Coastal Spawn (B)"
        spawnEffect:b=no
        isStrictSpawn:b=yes
        resetStrictSpawnIndex:b=no
        isAirfield:b=no
        isUnit:b=no
        forceCreate:b=no
        useExisting:b=no
        ignoreTeamsOnReuse:b=no
        isIndividual:b=no
        onlyOnePlayerPerSpawnPoint:b=yes
        removeAreas:b=no
        replaceAreas:b=no
        canSpawnOnNeutral:b=no
        showOnMap:b=yes
        radius:r=-1
        target:t="Race_Spawn_teamB"
        team:t="B"

        tags{
          ship:b=yes
          boat:b=yes
          type_frigate:b=no
          type_destroyer:b=no
          type_light_cruiser:b=no
          type_heavy_cruiser:b=no
          type_battlecruiser:b=no
          type_battleship:b=no
          type_submarine:b=no
        }
      }

      missionBattleArea{
        air:b=yes
        ground:b=yes
        mapArea:b=yes
        airMapArea:b=yes
        killArea:b=no
        detectionArea:b=no
        killOutOfBattleArea:b=yes
        area:t="BattleArea"
        newGridHorizontalCellCount:i=0
        team:t="Both"
      }
    }

    else_actions{}
  }

  Race_Start{
    is_enabled:b=yes
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=no
    }

    events{
      periodicEvent{
        time:r=0.01
      }
    }

    conditions{}
    actions{
      missionSetTimeSpeed{
        speed:r=0.01
        realtimeTriggers:b=yes
      }

      beginRaceMode{
        tankRace:b=yes
        checkAreaPrefix:t="Race_Waypoint_"
        waypointsPrefix:t="Race_Waypoint"
        doubleWaypoints:b=yes
        waypointScale:r=5
        respawnVerticalOffset:r=0
        respawnForwardOffset:r=0
        statisticsScreenAfterFinish:b=yes
        reverse:b=no
        isPathClosed:b=no
        defaultTimeToDisableWeapon:r=20
      }

      triggerEnable{
        target:t="Players_Active"
      }
    }

    else_actions{}
  }

  Players_Active{
    is_enabled:b=no
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=no
    }

    events{
      periodicEvent{
        time:r=0.1
      }
    }

    conditions{
      unitWhenStatus{
        object_type:t="isAlive"
        check_objects:t="any"
        object_marking:i=0
        object_var_name:t=""
        object_var_comp_op:t="equal"
        object_var_value:i=0
        target_type:t="isAlive"
        check_period:r=1
        object:t="All_Players"
      }
    }

    actions{
      triggerEnable{
        target:t="Race_Start_Timer"
      }
    }

    else_actions{}
  }

  Race_Start_Timer{
    is_enabled:b=no
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=yes
    }

    events{
      periodicEvent{
        time:r=1
      }
    }

    conditions{
      varCompareInt{
        var_value:t="start_time_integer"
        value:i=0
        comparasion_func:t="notLess"
      }
    }

    actions{
      varAddString{
        value:t="@start_time_integer"
        digits:i=2
        var:t="start_hint_string"
      }

      playHint{
        hintType:t="standard"
        name:t="@start_hint_string"
        action:t="show"
        shouldFadeOut:b=no
        isOverFade:b=no
        time:r=-1
        priority:i=0
        target_marking:i=0
        object_var_name:t=""
        object_var_comp_op:t="equal"
        object_var_value:i=0
      }

      varModify{
        operator:t="subAB"
        value:r=1
        var:t="start_time_integer"
      }

      varSetString{
        value:t="hints/ffa_race_starts_in_"
        var:t="start_hint_string"
      }
    }

    else_actions{
      missionSetTimeSpeed{
        speed:r=1
        realtimeTriggers:b=yes
      }

      unitSetZeroAmmo{
        target:t="All_Players"
        modificationReset:t="ship_smoke_screen_system_mod"
      }

      unitSetZeroAmmo{
        target:t="All_Players"
        modificationReset:t="ship_main_caliber_support"
      }

      wait{
        time:r=2
      }

      playHint{
        hintType:t="standard"
        name:t=""
        action:t="show"
        shouldFadeOut:b=no
        isOverFade:b=no
        time:r=-1
        priority:i=0
        target_marking:i=0
        object_var_name:t=""
        object_var_comp_op:t="equal"
        object_var_value:i=0
      }

      triggerDisable{
        target:t="Race_Start_Timer"
      }
    }
  }
}

mission_objectives{
  isCategory:b=yes
  is_enabled:b=yes
}

variables{
  start_hint_string:t=""
  start_time_integer:i=20
}

