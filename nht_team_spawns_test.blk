      enableAfterComplete:b=yes
    }

    events{
      initMission{}
      periodicEvent{
        time:r=500
      }
    }

    conditions{}
    actions{
      missionSetFade{
        mode:t="fadeIn"
        color:p3=0, 0, 0
        time:r=1
      }

      wait{
        time:r=4
      }

      missionSetFade{
        mode:t="fadeOut"
        color:p3=0, 255, 0
        time:r=4
      }
    }

    else_actions{}
  }

