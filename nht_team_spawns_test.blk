  mission{
    type:t="singleMission"
    level:t="levels/hangar_field_winter.bin"
    environment:t="Noon"
    weather:t="clear"
    locName:t="Hangar Field by guifoxtel@psn"
    locDesc:t="Hangar Field Winter map to be played in free style. Full of stuff to play around."
    scoreLimit:i=500
    deathPenaltyMul:r=0
    postfix:t="_Conq"
    allowedKillStreaks:b=yes
    remapAiTankModels:b=yes
    allowEmptyTeams:b=yes
    respawnTimeMultiplier:r=0
    country_axis:t="germany"
    country_allies:t="ussr"
    campaign:t="UserMissions"
    restoreType:t="attempts"
    optionalTakeOff:b=no
    forceSkiesInitialRandomSeed:b=yes
    windSpeed:p2=20, 10
    windDirectionDeg:p2=278, 3
    isPhysPredictionEnabled:b=no
    isSelfSmoothingEnabled:b=yes
    isPreciseCollisionDetectionEnabled:b=yes

    netDifficultyBlk{
      keepDeadShipOnMap:b=no
    }

    missionType{
      _Dom:b=no
      _Conq:b=no
      _CnvA:b=no
      _CnvB:b=no
      _ArtDA:b=no
      _ArtDB:b=no
      _Bttl:b=no
      _DBttlA:b=no
      _DBttlB:b=no
      _Bto:b=no
      _Flc:b=no
      _v1_race_straight:b=no
      _v1_race_inverted:b=no
      _v2_race_straight:b=no
      _v2_race_inverted:b=no
      _Conq1:b=no
      _Conq2:b=no
      _Conq3:b=no
      _Conq4:b=no
      _Conq5:b=no
      _Conq6:b=no
    }

    stars{
      year:i=2020
      localTime:r=14
    }
  }

  atmosphere{
    pressure:r=12
    temperature:r=-5
  }

  briefing{
    place_loc:t="Hangar field"
    date_loc:t="2021"
    objective_loc:t=""
    music:t="action_14"
    viewAreaScale:r=0.5

    part{
      event:t=""
      minTime:i=10

      slide{
        map:b=yes
        minTime:i=8
        picture:t=""
        showAirMap:b=no
      }
    }
  }

  aiParams{
    aiEffectivenessViscosity:r=100
    effectivenessDistances:p2=25000, 10000
  }
}

imports{}
triggers{
  isCategory:b=yes
  is_enabled:b=yes

  init_mission{
    is_enabled:b=yes
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=no
    }

    events{
      initMission{}
    }

    conditions{}
    actions{
      missionMarkAsWaypoint{
        visible:b=yes
        primary:b=yes
        oriented:b=yes
        ignoreDifficulty:b=no
        scale:r=1
        target:t="speed_boost400"
        target:t="speed_boost1000"
        target:t="speed_boost2000"
        target:t="speed_boostreset"
      }

      unitSetStealth{
        set:b=yes
        radius:r=0
        target:t="stealth_squad"
      }

      unitSetProperties{
        object:t="immortal_squad"
        object_marking:i=0
        object_var_name:t=""
        object_var_comp_op:t="equal"
        object_var_value:i=0
        isImmortal:b=yes
      }

      unitSetProperties{
        object:t="bplane_squad"
        object:t="bship_squad"
        object_marking:i=0
        object_var_name:t=""
        object_var_comp_op:t="equal"
        object_var_value:i=0
        effShootingRate:r=0.5
      }

      unitSetProperties{
        object:t="all_players_squad"
        object_marking:i=0
        object_var_name:t=""
        object_var_comp_op:t="equal"
        object_var_value:i=0
        enableShipCollisionAvoidance:b=yes
        advancedCollisionAvoidance:b=yes
        startFullSpeed:b=yes
      }

      unitSetProperties{
        object:t="all_players_squad"
        object_marking:i=0
        object_var_name:t=""
        object_var_comp_op:t="equal"
        object_var_value:i=0
        destroyRIByCollision:b=yes
        registerCollisions:b=yes
      }

      countUnitsKilledByTeam{
        team:t="Both"
      }

      missionMarkAsLandingZone{
        visible:b=yes
        spawnEffect:b=yes
        radius:i=50
        army:i=0
        target:t="airfield01"
        team:t="Both"
      }

      addAirfield{
        runwayStart:t="tank_respawnA02"
        runwayEnd:t="tank_respawnA06"
        runwayWidth:r=40
        army:i=0
        spawnPoint:t="tank_respawnA02"
      }

      unitSetProperties{
        object:t="dummy400"
        object:t="dummy1000"
        object:t="dummy2000"
        object:t="dummyreset"
        object_marking:i=0
        object_var_name:t=""
        object_var_comp_op:t="equal"
        object_var_value:i=0
        forceVisibleOnMap:b=yes
      }
    }

    else_actions{}
  }

  immortality{
    is_enabled:b=yes
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=yes
    }

    events{
      periodicEvent{
        time:r=0.01
      }
    }

    conditions{
      unitWhenInArea{
        math:t="3D"
        object_type:t="isAlive"
        object_marking:i=0
        object_var_name:t=""
        object_var_comp_op:t="equal"
        check_objects:t="any"
        object:t="all_players_squad"
        target:t="tank_respawnG08"
        target:t="plane_respawnG01"
        target:t="ship_respawnG02"
      }
    }

    actions{
      unitSetProperties{
        object:t="all_players_squad"
        object_marking:i=0
        object_var_name:t=""
        object_var_comp_op:t="equal"
        object_var_value:i=0
        useForTriggerFiltered:b=yes
        isImmortal:b=yes
        cannotShoot:b=yes
      }
    }

    else_actions{}
  }

  cap_points{
    is_enabled:b=yes
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=no
    }

    events{
