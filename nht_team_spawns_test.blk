      }
    }

    conditions{}
    actions{
      missionMarkAsCaptureZone{
        army:i=0
        timeMultiplier:r=1
        disableZone:b=no
        name_for_respawn_base:t=""
        target:t="a_point"
        target:t="b_point"
        target:t="c_point"
        target:t="d_point"
        playAirfieldSound:b=yes
        canCaptureInAir:b=yes
        canCaptureByGM:b=yes
        onlyPlayersCanCapture:b=yes
        zoneType:t="capture"
        auto_smoke:b=yes
        captureNoPenalty:b=yes
        showBorderOnMap:b=no

        zoneDefenders{}
        tags{
          helicopter:b=yes
          type_attack_helicopter:b=yes
          type_utility_helicopter:b=yes
          tank:b=yes
        }
      }
    }

    else_actions{}
  }

