          time:r=0
        }
      }

      conditions{
        missionNamePostfix{
          postfix:t="_v1_race_straight"
        }
      }

      actions{
        triggerDisable{
          target:t="start_mission_inverted"
        }

        missionSetTimeSpeed{
          speed:r=0.01
          realtimeTriggers:b=yes
        }

        beginRaceMode{
          checkAreaPrefix:t="area_"
          waypointsPrefix:t="area_"
          winners:i=1
          doubleWaypoints:b=yes
          waypointScale:r=0.45
          laps:i=1
