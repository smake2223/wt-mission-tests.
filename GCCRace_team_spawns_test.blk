    environment:t="Day"
    weather:t="good"
    missionDebriefing:t=""
    missionBriefing:t=""
    killLimit:i=10
    chapter:t="ffa"
    locName:t="[Race] Grand Canyon Circuit"
    locDesc:t="Air Race by Thai_Fighter"
    gt_race:b=yes
    openDiffLevels:b=yes
    postfix:t="_race"
    country_axis:t="japan"
    country_allies:t="britain"
    raceLaps:i=3
    raceWinners:i=3
    raceForceCannotShoot:b=yes
    campaign:t="UserMissions"
    restoreType:t="attempts"
    difficulty:t=""
    optionalTakeOff:b=no

