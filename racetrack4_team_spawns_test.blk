        time:r=-1
        priority:i=0
        isOverFade:b=no
        target_marking:i=0
        object_var_name:t=""
        object_var_comp_op:t="equal"
        object_var_value:i=0
        shouldBlink:b=no
      }

      triggerDisable{
        target:t="race_start_timer"
      }
    }
  }

