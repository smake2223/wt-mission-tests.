          tank:b=yes
        }
      }

      missionMarkAsRespawnPoint{
        loc_name:t="Spawn (B)"
        spawnEffect:b=no
        isAirfield:b=no
        isUnit:b=no
        isStrictSpawn:b=yes
        radius:r=-1
        useExisting:b=no
