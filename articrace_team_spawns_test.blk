mission_objectives{
  isCategory:b=yes
  is_enabled:b=yes

  phiphi_race_mission_objective{
    is_enabled:b=yes
    comments:t=""
    type:t="abstractMissionObjective"

    props{
      isPrimary:b=yes
      timeLimit:i=5000
      scoreConst:i=100
      scoreTime:i=400
      team:t="Both"
    }

    onSuccess{}
    onFailed{}
  }
}

variables{
  start_timer_int:i=10
  start_hint_id_str:t="hints/ffa_race_starts_in_"
}

