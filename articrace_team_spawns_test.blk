      _DBttlB:b=no
      _ArtDA:b=no
      _ArtDB:b=no
    }

    stars{
      year:i=2024
      month:i=4
      day:i=21
      localTime:r=16
    }

    customWeather{
      windDir:p2=0.6, 0.8
      wind_scale:r=1
      max_wind_strength:r=6
      wind_strength:r=3
    }

    tags{}
  }

  atmosphere{
    pressure:r=760
    temperature:r=15
  }

  spectator_points{}
  cover_points{}
  briefing{
    place_loc:t="Artic"
    date_loc:t=""
    objective_loc:t="Get the first place"
