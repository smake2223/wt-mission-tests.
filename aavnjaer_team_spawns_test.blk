triggers{
  isCategory:b=yes
  is_enabled:b=yes

  wyscig{
    is_enabled:b=no
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=no
    }

    events{
      periodicEvent{
        time:r=1
      }
    }

    conditions{}
    actions{
      beginRaceMode{
        tankRace:b=yes
        checkAreaPrefix:t="pkt_"
        waypointsPrefix:t="pkt_"
        doubleWaypoints:b=yes
        waypointScale:r=1.5
        respawnVerticalOffset:r=0
        respawnForwardOffset:r=0
        statisticsScreenAfterFinish:b=yes
        reverse:b=no
        isPathClosed:b=yes
        defaultTimeToDisableWeapon:r=50000
      }
    }

    else_actions{}
  }

  init{
    is_enabled:b=yes
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=no
    }

