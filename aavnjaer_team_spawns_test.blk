  wait{
    is_enabled:b=yes
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=yes
    }

    events{
      periodicEvent{
        time:r=1
      }
    }

    conditions{
      varCompareInt{
        var_value:t="licznik"
        value:i=0
        comparasion_func:t="notLess"
      }
    }

    actions{
      varAddString{
        value:t="@licznik"
        digits:i=2
        var:t="Wyscig_"
      }

      playHint{
        hintType:t="standard"
        name:t="@Wyscig_"
        action:t="show"
        shouldFadeOut:b=no
        isOverFade:b=no
        time:r=-1
        priority:i=0
        target_marking:i=0
        object_var_name:t=""
        object_var_comp_op:t="equal"
        object_var_value:i=0
        shouldBlink:b=no
      }

      varModify{
        operator:t="subAB"
        value:r=1
        var:t="licznik"
      }

      varSetString{
        value:t="Wyscig zacznie sie za_"
        var:t="Wyscig_"
      }

      unitSetProperties{
        object:t="wsiech ludej"
        isImmortal:b=yes
        cannotShoot:b=yes
        ignoreCollisions:b=yes
        cannotMove:b=yes
      }
    }

    else_actions{
      triggerEnable{
        target:t="wyscig"
      }

      unitSetProperties{
        object:t="wsiech ludej"
        targetableByAi:b=no
        isImmortal:b=yes
        ignoreCollisions:b=yes
        cannotMove:b=no
      }

      playHint{
        hintType:t="standard"
        name:t=""
        action:t="hideCur"
        shouldFadeOut:b=no
        isOverFade:b=no
        time:r=-1
        priority:i=0
        target_marking:i=0
        object_var_name:t=""
        object_var_comp_op:t="equal"
        object_var_value:i=0
      }

      triggerDisable{
        target:t="wait"
      }
    }
  }

  startej{
    is_enabled:b=no
