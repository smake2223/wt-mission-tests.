  liczniok{
    is_enabled:b=yes
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=no
    }

    events{
      periodicEvent{
        time:r=1
      }
    }

    conditions{}
    actions{
      wait{
        time:r=10
      }

      triggerDisable{
        target:t="czekej"
      }

      triggerEnable{
        target:t="startej"
      }
    }

    else_actions{}
  }
}

