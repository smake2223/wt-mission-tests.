          object_type:t="isAlive"
          object_marking:i=0
          check_objects:t="all"
          object_var_name:t=""
          object_var_comp_op:t="equal"
          object:t="players_squad"
          target:t="death_trap_area"
        }
      }

      actions{
        unitSetProperties{
          object_marking:i=0
          object_var_name:t=""
          object_var_comp_op:t="equal"
          object_var_value:i=0
          object:t="air_defence_squad"
          stealthRadius:r=0
          attack_type:t="hold_fire"
          accuracy:r=1
          effShootingRate:r=1
        }
      }

      else_actions{
      }
    }
  }

  airspawn_squad{
    isCategory:b=yes
