        enableAfterComplete:b=yes
      }

      events{
        periodicEvent{
          time:r=5
        }
      }

      conditions{
        unitWhenInArea{
          math:t="3D"
          object_type:t="isAlive"
          object_marking:i=0
          check_objects:t="any"
          object_var_name:t=""
          object_var_comp_op:t="equal"
          object:t="players_squad"
          target:t="death_trap_area"
        }
      }

      actions{
        unitSetProperties{
          object_marking:i=0
          object_var_name:t=""
          object_var_comp_op:t="equal"
          object_var_value:i=0
          object:t="air_defence_squad"
          stealthRadius:r=0
          attack_type:t="fire_at_will"
        }

        unitAttackTarget{
          playerAttracted:b=no
          object:t="air_defence_squad"
          attack_type:t="fire_zone"
          fireRandom:b=yes
          fireZone:t="death_trap_area"
          effShootingRateInZone:r=1
          accuracyInZone:r=1.5
        }
      }

      else_actions{
      }
    }

    air_defence_sleeps{
      is_enabled:b=yes
