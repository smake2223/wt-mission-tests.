        useExisting:b=no
        isIndividual:b=no
        removeAreas:b=no
        canSpawnOnNeutral:b=no
        showOnMap:b=yes
        resetStrictSpawnIndex:b=no
        forceCreate:b=no
        onlyOnePlayerPerSpawnPoint:b=no
        replaceAreas:b=no
        ignoreTeamsOnReuse:b=no
        target:t="airspawn_squad_teamB"
        team:t="B"

        tags{
          tank:b=no
          artillery:b=no
          aaa:b=no
        }
      }

      unitSetStealth{
        set:b=yes
        radius:r=0
        target:t="air_defence_squad"
      }

      triggerDisable{
        target:t="miss_init_v1_inverted"
      }
    }

    else_actions{}
  }

