imports{}
triggers{
  isCategory:b=yes
  is_enabled:b=yes

  miss_init_v1_straight{
    is_enabled:b=yes
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=no
    }

    events{
      initMission{}
    }

    conditions{
      missionNamePostfix{
        postfix:t="_v1_race_straight"
      }
    }

    actions{
      missionMarkAsRespawnPoint{
        loc_name:t="Spawn (A)"
        spawnEffect:b=no
        isAirfield:b=no
        isUnit:b=no
        isStrictSpawn:b=yes
        radius:r=-1
        useExisting:b=no
        isIndividual:b=no
        removeAreas:b=no
        canSpawnOnNeutral:b=no
        showOnMap:b=yes
        resetStrictSpawnIndex:b=no
        forceCreate:b=no
        onlyOnePlayerPerSpawnPoint:b=no
        replaceAreas:b=no
        ignoreTeamsOnReuse:b=no
        target:t="airspawn_squad_teamA"
        team:t="A"

        tags{
          tank:b=no
          artillery:b=no
          aaa:b=no
        }
      }

      missionMarkAsRespawnPoint{
        loc_name:t="Spawn (B)"
        spawnEffect:b=no
        isAirfield:b=no
        isUnit:b=no
        isStrictSpawn:b=yes
