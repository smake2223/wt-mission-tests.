      }

      unitSetProperties{
        object_marking:i=0
        aerobaticsSmoke:i=5
        object_var_name:t=""
        object_var_comp_op:t="equal"
        object_var_value:i=0
        object:t="t1_player05"
        object:t="t1_player12"
        object:t="t2_player02"
        object:t="t2_player09"
